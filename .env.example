# --- REQUIRED in production: random string, 32+ chars (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=

# --- Trust lists (hex SHA-256, comma separated). Get the certificate from the source you trust, then run:
#     node scripts/fingerprint.mjs uidai-cert.cer
NEXT_PUBLIC_UIDAI_TRUSTED_SHA256=
NEXT_PUBLIC_PDF_TRUSTED_ROOTS_SHA256=
NEXT_PUBLIC_AADHAAR_PDF_SIGNER_SHA256=

# --- Optional: where users.json / audit.jsonl / queue.json are stored (default ./data)
# VERISIGHT_DATA_DIR=

# --- Optional: Python document-processing service (default http://127.0.0.1:5000)
VERISIGHT_BACKEND_URL=http://127.0.0.1:5000

# --- Optional: pinned SHA-256 fingerprints (hex, comma separated) of keys whose signed permit QR codes you trust.
#     Only the VeriSight DEMO envelope (VSP1) can be signature-checked. Empty = every permit issuer is shown as "unknown".
NEXT_PUBLIC_PERMIT_TRUSTED_KEYS_SHA256=

# --- DEMO ONLY: true = ANY id/passphrase logs in (open login for showing the project). NEVER set in a real deployment.
DEMO_MODE=
